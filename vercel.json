{
  "regions": [
    "iad1"
  ],
  "headers": [
    {
      "source": "/api/card",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/img/favicon.ico"
    },
    {
      "source": "/img/:path*",
      "destination": "/img/:path*"
    }
  ]
}
