{
  "regions": ["hnd1"],
  "functions": {
    "api/card.js": {
      "includeFiles": "fonts/**"
    }
  },
  "headers": [
    {
      "source": "/api/card",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/favicon.ico",
      "destination": "/img/favicon.svg"
    },
    {
      "source": "/img/:path*",
      "destination": "/img/:path*"
    }
  ]
}
